{
  "name": "cmms-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "db:ensure": "tsx src/database/ensure-db-runner.ts",
    "db:ensure:prod": "node dist/database/ensure-db-runner.js",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/AutoSchema",
    "migration:run": "npm run db:ensure && npm run typeorm -- migration:run",
    "migration:run:prod": "npm run db:ensure:prod && typeorm -d dist/database/data-source.js migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "security:audit": "npm audit --audit-level=high",
    "security:test": "jest src/tests/security-hardening.test.ts --runInBand",
    "lint": "echo \"No backend lint configured yet\"",
    "test": "jest --runInBand",
    "test:smoke": "jest src/tests/smoke.test.ts --runInBand",
    "worker:start": "tsx src/workers/backupWorker.ts",
    "worker:build": "node dist/workers/backupWorker.js"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^1.91.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "multer": "^2.1.1",
    "mysql2": "^3.11.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.5",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.20",
    "unzipper": "^0.12.3",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.5.4",
    "@types/nodemailer": "^6.4.16",
    "@types/supertest": "^6.0.3",
    "@types/unzipper": "^0.10.11",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}

