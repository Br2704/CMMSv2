NODE_ENV=development
PORT=3001
API_PREFIX=/api
TRUST_PROXY_HOPS=1
APP_NAME=OptiX Maintenance Pro
APP_COMPANY=TamOptiX Technologies
APP_TAGLINE=Powered by TamOptiX Technologies

# Database configuration
# Select database engine and app database name in backend/src/config/database.selection.ts
# Default app database name is: JK Fenner CMMS
# Set connection values below for the selected engine.
# Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# DATABASE_URL=mysql://root:root@localhost:3306/mysql
# DATABASE_URL=mssql://sa:StrongP@ssw0rd@localhost:1433/master
# DATABASE_URL=mongodb://root:root@localhost:27017/admin
# DATABASE_URL=sqlite://./JK_Fenner_CMMS.sqlite
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_FILE=
DB_SSL=false

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
JWT_ISSUER=cmms-backend
JWT_AUDIENCE=cmms-web
AUTH_SESSION_MAX_HOURS=12
LOGIN_CAPTCHA_THRESHOLD=3
LOGIN_LOCKOUT_THRESHOLD=8
LOGIN_LOCKOUT_MINUTES=10
MFA_ISSUER=OptiX Maintenance Pro
DATA_ENCRYPTION_KEY=
SECURITY_ALERT_EMAILS=
SECURITY_TEAM_USER_IDS=
SECURITY_ENABLE_REQUEST_SIGNATURE=false
REQUEST_SIGNATURE_SECRET=
UPLOAD_MAX_IMAGE_BYTES=2000000
UPLOAD_MAX_DOCUMENT_BYTES=5000000

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Web Push (required in production for push notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─────────────────────────────────────────────────
# Mail Server Configuration (SMTP)
# ─────────────────────────────────────────────────
# Supported providers:
#   - Generic SMTP (any provider)
#   - Zoho Mail: smtp.zoho.com:587
#   - Microsoft 365: smtp.office365.com:587
#   - Google Workspace: smtp.gmail.com:587
#   - AWS SES: email-smtp.<region>.amazonaws.com:587
#   - SendGrid: smtp.sendgrid.net:587
#   - cPanel: mail.<your-domain>.com:465
#
# DNS Setup Required for Production:
#   1. SPF: v=spf1 include:<provider> ~all
#   2. DKIM: Generate 2048-bit key, publish as TXT record
#   3. DMARC: v=DMARC1; p=quarantine; rua=mailto:dmarc@yourdomain.com
#   4. MX: Configure mail exchange records
#   5. Domain verification with your mail provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tamoptix.tech
SMTP_FROM_NAME=Powered by TamOptiX Technologies
MAIL_QUEUE_ENABLED=true
MAIL_RETRY_MAX=3
MAIL_RETRY_INTERVAL_MINUTES=5

FEATURE_BENCHMARKING=true
FEATURE_ESG_ADVANCED=true
FEATURE_RELIABILITY_ADVANCED=true

# Docker-friendly defaults for local container startup (override with secure values in real deployments)
# JWT_SECRET=change-this-to-a-strong-32-plus-character-secret
# JWT_REFRESH_SECRET=change-this-to-a-strong-32-plus-character-refresh-secret
# DATA_ENCRYPTION_KEY=change-this-to-a-strong-32-plus-character-encryption-key


