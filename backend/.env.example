NODE_ENV=development
PORT=3001
API_PREFIX=/api
TRUST_PROXY_HOPS=0

# Database configuration
# Select database engine and app database name in backend/src/config/database.selection.ts
# Default app database name is: JK Fenner CMMS
# Set connection values below for the selected engine.
# Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# DATABASE_URL=mysql://root:root@localhost:3306/mysql
# DATABASE_URL=mssql://sa:StrongP@ssw0rd@localhost:1433/master
# DATABASE_URL=mongodb://root:root@localhost:27017/admin
# DATABASE_URL=sqlite://./JK_Fenner_CMMS.sqlite
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_FILE=
DB_SSL=false

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
JWT_ISSUER=cmms-backend
JWT_AUDIENCE=cmms-web
AUTH_SESSION_MAX_HOURS=12
LOGIN_CAPTCHA_THRESHOLD=3
LOGIN_LOCKOUT_THRESHOLD=8
LOGIN_LOCKOUT_MINUTES=10
MFA_ISSUER=TamOptiX CMMS
DATA_ENCRYPTION_KEY=
SECURITY_ALERT_EMAILS=
SECURITY_TEAM_USER_IDS=
SECURITY_ENABLE_REQUEST_SIGNATURE=false
REQUEST_SIGNATURE_SECRET=
UPLOAD_MAX_IMAGE_BYTES=2000000
UPLOAD_MAX_DOCUMENT_BYTES=5000000

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

FEATURE_BENCHMARKING=true
FEATURE_ESG_ADVANCED=true
FEATURE_RELIABILITY_ADVANCED=true


