NODE_ENV=development
PORT=3001
API_PREFIX=/api

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cmms
DB_SSL=false

JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

SUPERADMIN_EMAIL=superadmin@cmms.local
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_FULL_NAME=CMMS Super Admin
ROOT_ADMIN_EMAIL=rootadmin@cmms.local
ROOT_ADMIN_PASSWORD=ChangeMe123!
ROOT_ADMIN_FULL_NAME=CMMS Root Admin
SEED_SUPERADMIN=true

FEATURE_BENCHMARKING=true
FEATURE_ESG_ADVANCED=true
FEATURE_RELIABILITY_ADVANCED=true
