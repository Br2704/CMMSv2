# ───────────────────────────────────────────────────────────────
#  CMMS v2 — Docker Environment Template
#
#  DO NOT USE THIS FILE DIRECTLY. Instead, run:
#    ./scripts/docker-generate-secrets.sh      (Linux/macOS/Git Bash)
#    .\scripts\docker-generate-secrets.ps1      (Windows PowerShell)
#
#  This template is for reference only.
# ───────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────
DB_USER=cmms_xxxx
DB_PASSWORD=<32-char-strong-password>
DB_PORT_EXTERNAL=5432

# ── Backend Secrets ────────────────────────────────────────────
# Generate with: openssl rand -base64 64 | tr '+/' '-_' | tr -d '='
JWT_SECRET=<64-char-base64url-secret>
JWT_REFRESH_SECRET=<64-char-base64url-secret>
DATA_ENCRYPTION_KEY=<32-char-base64url-secret>

# ── Frontend ───────────────────────────────────────────────────
FRONTEND_PORT=8081
FRONTEND_URL=http://localhost:8081
APP_CORS_ORIGINS=http://localhost:8081,http://localhost

# ── Backend Port ───────────────────────────────────────────────
BACKEND_PORT=3001

# ── pgAdmin (tools profile only) ───────────────────────────────
PGADMIN_EMAIL=admin@cmms.local
PGADMIN_PASSWORD=<24-char-strong-password>
