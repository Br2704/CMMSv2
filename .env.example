[TEMPLATE]
# ═══════════════════════════════════════════════════════════════════
#  CMMS v2 — Environment Variables (SECURITY HARDENED)
# ═══════════════════════════════════════════════════════════════════
#  Run the setup script to auto-generate this file with secure values:
#  PowerShell:  .\setup.ps1
#  Bash:        chmod +x setup.sh && ./setup.sh
#
#  Or manually:
#    Copy this file to .env, replace all "changeme_*" values with secure secrets
#    Minimum entropy: 256-bit (32+ chars hex/base64) for all secrets
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL)
# ═══════════════════════════════════════════════════════════════════
# SECURITY: Use a strong, unique password (min 32 chars) and
#   restrict DB_USER to only the permissions this app requires.
# ═══════════════════════════════════════════════════════════════════

DB_USER=postgres
DB_PASSWORD=changeme_db_password_32chars_min
DB_NAME=postgres
DB_PORT_EXTERNAL=5432

# ═══════════════════════════════════════════════════════════════════
# SECRETS (256-bit minimum)
# ═══════════════════════════════════════════════════════════════════
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# SECURITY: All secrets below must be:
#   - At least 32 characters long
#   - Cryptographically random (use the command above)
#   - Unique - DO NOT reuse the same value for different secrets
#   - Stored securely (never committed to git, use vault in prod)
# ═══════════════════════════════════════════════════════════════════

JWT_SECRET=changeme_jwt_secret_32chars_min
JWT_REFRESH_SECRET=changeme_refresh_secret_32chars_min
DATA_ENCRYPTION_KEY=changeme_encryption_key_32chars_min

# ═══════════════════════════════════════════════════════════════════
# REDIS (distributed caching & rate limiting)
# ═══════════════════════════════════════════════════════════════════
# Redis is used for distributed rate limiting, idle timeout tracking,
# and session activity monitoring. If Redis is unavailable, the app
# gracefully falls back to in-memory stores (single-instance mode).
#
# Use REDIS_URL for a single connection string (overrides individual settings):
#   REDIS_URL=redis://user:password@host:6379
# Or set individual fields:
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=changeme_redis_password
# REDIS_TLS=true
REDIS_KEY_PREFIX=cmms:

# ═══════════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════════

APP_CORS_ORIGINS=http://localhost:8081,http://localhost
FRONTEND_URL=http://localhost:8081
BACKEND_PORT=3001
FRONTEND_PORT=8081

# ═══════════════════════════════════════════════════════════════════
# ADMIN BOOTSTRAP CREDENTIALS
# ═══════════════════════════════════════════════════════════════════
# SECURITY: Change these immediately after initial bootstrap.
# Root admin has PLATFORM-level access - treat with extreme care.
# ═══════════════════════════════════════════════════════════════════

ROOT_ADMIN_EMAIL=admin@tamoptix.tech
ROOT_ADMIN_PASSWORD=changeme_admin_password_16chars
ROOT_ADMIN_FULL_NAME=TamOptiX Admin

# ═══════════════════════════════════════════════════════════════════
# DEVELOPMENT OVERRIDES (optional, for docker compose --profile dev)
# ═══════════════════════════════════════════════════════════════════
# These are only used when running the development profile.
# To start dev:   docker compose --profile dev up -d
# PGADMIN_EMAIL=admin@cmms.local
# PGADMIN_PASSWORD=admin
